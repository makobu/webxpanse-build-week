# Application
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/crm/public
BASE_PATH=/crm/public
APP_TIMEZONE=Africa/Nairobi

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=crm
DB_USER=root
DB_PASS=

# Generate independent random values before any shared or production deployment.
APP_SECRET=replace-with-a-long-random-value
SESSION_SECRET=replace-with-a-different-long-random-value
PROCESS_QUEUE_SECRET=replace-with-another-long-random-value

# Optional shared AI fallback. Workspace Settings can provide an isolated
# OpenAI-compatible provider and key instead.
AI_SERVICE_URL=https://api.openai.com/v1/chat/completions
AI_API_KEY=
AI_MODEL=
AI_RESPONSES_ENABLED=true

# Optional cache
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
