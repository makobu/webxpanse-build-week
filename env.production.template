# Production Environment Configuration
# Copy this content to .env on your live server.
#
# Configure from the top down:
# 1. Required live settings
# 2. Feature credentials you plan to enable
# 3. Optional runtime defaults

# ---------------------------------------------------------------------------
# 1) REQUIRED LIVE SETTINGS
# ---------------------------------------------------------------------------

# App identity and public URLs
APP_ENV=production
APP_DEBUG=false
DEBUG=false
APP_URL=https://crm.makdennis.dev
APP_NAME=AI Business Incubator
APP_TIMEZONE=Africa/Nairobi
COMPANY_NAME=AI Business Incubator
PRIVACY_CONTACT_EMAIL=privacy@example.com

# Brand copy shown in the product
BRAND_PRODUCT_NAME=AI Business Incubator
BRAND_ASSISTANT_NAME=Clarity
BRAND_TAGLINE_PRIMARY=Build With Clarity. Scale With Intelligence.
BRAND_TAGLINE_SECONDARY=Your AI Co-Founder for Structured Growth.
BRAND_POSITIONING_LINE=If Clarity Was a System.
BRAND_VALUE_PROP=A system that reduces decision fatigue for founders.
BRAND_OUTCOME_LINE=Get AI-guided execution that tells you what actually moves revenue.

# Database connection
DB_HOST=localhost
DB_NAME=replace_with_database_name
DB_USER=replace_with_database_user
DB_PASS=replace_with_database_password
DB_CHARSET=utf8mb4
DB_STRICT_MODE=true
EMAIL_QUEUE_LEASE_SECONDS=300
WORKFLOW_QUEUE_LEASE_SECONDS=600
# Set a stable unique value per worker process when workers are supervised.
QUEUE_WORKER_ID=

# Main SMTP account
SMTP_HOST=mail.webxpanse.com
SMTP_PORT=465
SMTP_USER=info@webxpanse.com
SMTP_PASS=replace_with_smtp_password
SMTP_ENCRYPTION=ssl
SMTP_FROM_EMAIL=info@webxpanse.com
SMTP_FROM_NAME=Dennis

# Security secrets - replace all placeholder values before going live
APP_SECRET=replace-with-a-long-random-app-secret
APP_KEY=replace-with-a-long-random-app-key
SESSION_SECRET=replace-with-a-long-random-session-secret
PROCESS_QUEUE_SECRET=replace-with-a-long-random-secret
SESSION_LIFETIME=7200
CSRF_TOKEN_LIFETIME=3600

# Backups and restore readiness
# Prefer a host-level directory outside the deployed app tree.
BACKUP_DIR=/home/your-account/backups/crm
RETENTION_DAYS=7
RETENTION_WEEKLY=4
BACKUP_MAX_AGE_HOURS=24
UPLOADS_BACKUP_MAX_AGE_HOURS=48
BACKUP_OFFSITE_PATH=
BACKUP_RUNBOOK_PATH=docs/backup-restore-readiness.md
BACKUP_RESTORE_DRILL_AT=

# Optional explicit binary paths when MySQL tools are not in PATH.
MYSQLDUMP_BIN=
MYSQL_BIN=
TAR_BIN=

# ---------------------------------------------------------------------------
# 2) FEATURE CREDENTIALS TO ENABLE WHEN USED
# ---------------------------------------------------------------------------

# AI services
AI_SERVICE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-3.5-turbo

# Firebase Cloud Messaging for mobile push
# Set either the inline JSON or the path on the production server.
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
FCM_SERVICE_ACCOUNT_PATH=

# WhatsApp Cloud API
WHATSAPP_API_URL=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_VERBOSE_DEBUG=false
META_APP_ID=
META_APP_SECRET=
META_APP_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v24.0

# Social Media plugin OAuth providers
# Register these exact callbacks with each provider:
#   APP_URL/api/social/oauth/callback.php?provider=meta
#   APP_URL/api/social/oauth/callback.php?provider=linkedin
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=202606

# SaaS billing providers
PAYSTACK_SECRET_KEY=
PAYSTACK_FAKE_MODE=false
PAYSTACK_FAKE_AUTH_BASE_URL=
PAYSTACK_FAKE_CHARGE_STATUS=
PAYSTACK_FAKE_VERIFY_STATUS=
PAYSTACK_FAKE_GATEWAY_RESPONSE=

MPESA_ENABLED=false
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
MPESA_FAKE_MODE=false
MPESA_FAKE_STK_RESPONSE_CODE=0
MPESA_FAKE_QUERY_RESULT_CODE=0
MPESA_FAKE_RECEIPT_NUMBER=

# OAuth mail providers
GMAIL_MAIL_CLIENT_ID=
GMAIL_MAIL_CLIENT_SECRET=
GOOGLE_WORKSPACE_MAIL_CLIENT_ID=
GOOGLE_WORKSPACE_MAIL_CLIENT_SECRET=
GMAIL_ASSISTANT_MAIL_CLIENT_ID=
GMAIL_ASSISTANT_MAIL_CLIENT_SECRET=

# Calendar OAuth providers
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
MICROSOFT_CALENDAR_CLIENT_ID=
MICROSOFT_CALENDAR_CLIENT_SECRET=

# Enrichment and scoring providers
HUNTER_API_KEY=
CLEARBIT_API_KEY=
PDL_API_KEY=
AUTO_ENRICH_CONTACTS=false
AUTO_ENRICH_ON_EMAIL=false
AUTO_ENRICH_ON_UPDATE=false
AUTO_USE_RECOMMENDED_WEIGHTS=false

# ---------------------------------------------------------------------------
# 3) OPTIONAL RUNTIME DEFAULTS
# ---------------------------------------------------------------------------

# Runtime topology. Use redis or memcached for cache and sessions before
# increasing APP_INSTANCE_COUNT above 1.
APP_INSTANCE_COUNT=1
CACHE_DRIVER=auto
SESSION_DRIVER=files
SESSION_REDIS_PREFIX=crm_session:

# Redis cache/session support
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
MEMCACHED_HOST=127.0.0.1
MEMCACHED_PORT=11211

# Logging and diagnostics
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_DIR=../logs
ENABLE_PUBLIC_DIAGNOSTICS=false
DISABLE_QUERY_MONITORING=false
DB_QUERY_GUARD_LIMIT=0

# Incoming mail polling
IMAP_ENABLED=false
IMAP_PROTOCOL=imap
IMAP_HOST=
IMAP_PORT=993
IMAP_ENCRYPTION=ssl
IMAP_USER=
IMAP_PASS=
IMAP_FOLDER=INBOX
IMAP_FETCH_INTERVAL=300

# Personal Assistant SMTP
# Leave empty to use the main SMTP account above.
# Use a separate account to avoid sending assistant replies/digests through main CRM.
# EMAIL_ASSISTANT_SMTP_HOST=
# EMAIL_ASSISTANT_SMTP_PORT=587
# EMAIL_ASSISTANT_SMTP_USER=
# EMAIL_ASSISTANT_SMTP_PASS=
# EMAIL_ASSISTANT_SMTP_ENCRYPTION=tls
# EMAIL_ASSISTANT_FROM_EMAIL=
# EMAIL_ASSISTANT_FROM_NAME=Personal Assistant
# EMAIL_ASSISTANT_ALLOWED_SENDERS=admin@example.com,user@example.com

# Email assistant
EMAIL_ASSISTANT_ENABLED=false
EMAIL_ASSISTANT_Q&A_ENABLED=false
EMAIL_ASSISTANT_SYSTEM_EMAIL=
EMAIL_ASSISTANT_ALLOWED_SENDERS=
EMAIL_ASSISTANT_DEFAULT_TONE=professional
EMAIL_ASSISTANT_THREAD_CONTEXT_WINDOW=10
EMAIL_ASSISTANT_MIN_CONFIDENCE=0.70
EMAIL_ASSISTANT_MIN_SEND_CONFIDENCE=0.85
EMAIL_ASSISTANT_ACTIVITY_LOGGING=true
EMAIL_ASSISTANT_ALLOW_CLARIFYING_QUESTIONS=true
EMAIL_ASSISTANT_CUSTOMER_THREAD_ENABLED=false
EMAIL_ASSISTANT_CUSTOMER_SEND_ENABLED=false
EMAIL_ASSISTANT_INSTRUCTIONS_ENABLED=true
EMAIL_ASSISTANT_IMAP_ENABLED=false
EMAIL_ASSISTANT_IMAP_PROTOCOL=imap
EMAIL_ASSISTANT_IMAP_HOST=
EMAIL_ASSISTANT_IMAP_PORT=993
EMAIL_ASSISTANT_IMAP_ENCRYPTION=ssl
EMAIL_ASSISTANT_IMAP_USER=
EMAIL_ASSISTANT_IMAP_PASS=
EMAIL_ASSISTANT_IMAP_FOLDER=INBOX
EMAIL_ASSISTANT_SKILL_ADD_NOTE=true
EMAIL_ASSISTANT_SKILL_CREATE_CONTACT=true
EMAIL_ASSISTANT_SKILL_DELETE_CONTACT=false
EMAIL_ASSISTANT_SKILL_ENRICH_CONTACT=true
EMAIL_ASSISTANT_SKILL_GET_PIPELINE=true
EMAIL_ASSISTANT_SKILL_LIST_TASKS=true
EMAIL_ASSISTANT_SKILL_RUN_REPORT=false
EMAIL_ASSISTANT_SKILL_SCHEDULE_EVENT=false
EMAIL_ASSISTANT_SKILL_UPDATE_CONTACT=true
EMAIL_ASSISTANT_SKILL_VERIFY_EMAIL=true

# Email digests
EMAIL_DIGEST_ENABLED=false
EMAIL_DIGEST_RECIPIENTS=
EMAIL_DIGEST_TIME=08:00

# WhatsApp assistant
WHATSAPP_API_KEY=
WHATSAPP_ASSISTANT_ENABLED=false
WHATSAPP_ASSISTANT_PHONE_NUMBER=
WHATSAPP_ASSISTANT_PHONE_NUMBER_ID=
WHATSAPP_ASSISTANT_DIGEST_ENABLED=false
WHATSAPP_ASSISTANT_DIGEST_TIME=08:00
WHATSAPP_ASSISTANT_MAX_MESSAGE_CHARS=1200
WHATSAPP_ASSISTANT_MAX_MESSAGE_CHUNKS=3
