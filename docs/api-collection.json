{
  "info": {
    "name": "CRM API Collection",
    "description": "Complete API collection for Self-Hosted CRM System",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.0.0"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{api_key}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost/crm",
      "type": "string"
    },
    {
      "key": "api_key",
      "value": "",
      "type": "string"
    },
    {
      "key": "csrf_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "email",
                  "value": "admin@crm.local",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "password",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/public/login.php",
              "host": ["{{base_url}}"],
              "path": ["public", "login.php"]
            }
          }
        },
        {
          "name": "Get CSRF Token",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/csrf-token.php",
              "host": ["{{base_url}}"],
              "path": ["api", "csrf-token.php"]
            }
          }
        }
      ]
    },
    {
      "name": "Contacts",
      "item": [
        {
          "name": "Get All Contacts",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{api_key}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/contacts.php?limit=50&offset=0",
              "host": ["{{base_url}}"],
              "path": ["api", "contacts.php"],
              "query": [
                {
                  "key": "limit",
                  "value": "50"
                },
                {
                  "key": "offset",
                  "value": "0"
                }
              ]
            }
          }
        },
        {
          "name": "Get Contact by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{api_key}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/contacts.php?id=1",
              "host": ["{{base_url}}"],
              "path": ["api", "contacts.php"],
              "query": [
                {
                  "key": "id",
                  "value": "1"
                }
              ]
            }
          }
        },
        {
          "name": "Create Contact",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{api_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrf_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"John\",\n  \"last_name\": \"Doe\",\n  \"email\": \"john.doe@example.com\",\n  \"phone\": \"+1234567890\",\n  \"company\": \"Acme Corp\",\n  \"stage\": \"new\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/contacts.php",
              "host": ["{{base_url}}"],
              "path": ["api", "contacts.php"]
            }
          }
        },
        {
          "name": "Update Contact",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{api_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrf_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Jane\",\n  \"last_name\": \"Smith\",\n  \"email\": \"jane.smith@example.com\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/contacts.php?id=1",
              "host": ["{{base_url}}"],
              "path": ["api", "contacts.php"],
              "query": [
                {
                  "key": "id",
                  "value": "1"
                }
              ]
            }
          }
        },
        {
          "name": "Delete Contact",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{api_key}}"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrf_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/contacts.php?id=1",
              "host": ["{{base_url}}"],
              "path": ["api", "contacts.php"],
              "query": [
                {
                  "key": "id",
                  "value": "1"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Activities",
      "item": [
        {
          "name": "Get Activities",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{api_key}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/activities.php?contact_id=1&limit=20",
              "host": ["{{base_url}}"],
              "path": ["api", "activities.php"],
              "query": [
                {
                  "key": "contact_id",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            }
          }
        },
        {
          "name": "Create Activity",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{api_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrf_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"contact_id\": 1,\n  \"activity_type\": \"note\",\n  \"description\": \"Follow-up call scheduled\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/activities.php",
              "host": ["{{base_url}}"],
              "path": ["api", "activities.php"]
            }
          }
        }
      ]
    },
    {
      "name": "Email Templates",
      "item": [
        {
          "name": "Get All Templates",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{api_key}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/email_templates.php",
              "host": ["{{base_url}}"],
              "path": ["api", "email_templates.php"]
            }
          }
        },
        {
          "name": "Get Template by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{api_key}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/email_templates.php?id=1",
              "host": ["{{base_url}}"],
              "path": ["api", "email_templates.php"],
              "query": [
                {
                  "key": "id",
                  "value": "1"
                }
              ]
            }
          }
        },
        {
          "name": "Create Template",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{api_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrf_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Welcome Email\",\n  \"subject\": \"Welcome {first_name}!\",\n  \"body\": \"<html><body>Hello {first_name}, welcome to our CRM!</body></html>\",\n  \"variables\": [\"first_name\", \"last_name\"]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/email_templates.php",
              "host": ["{{base_url}}"],
              "path": ["api", "email_templates.php"]
            }
          }
        },
        {
          "name": "Test Template",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{api_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrf_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"template_id\": 1,\n  \"test_email\": \"test@example.com\",\n  \"test_data\": {\n    \"first_name\": \"John\",\n    \"last_name\": \"Doe\"\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/email_template_test.php",
              "host": ["{{base_url}}"],
              "path": ["api", "email_template_test.php"]
            }
          }
        }
      ]
    },
    {
      "name": "Search",
      "item": [
        {
          "name": "Global Search",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{api_key}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/search.php?q=john&type=contacts",
              "host": ["{{base_url}}"],
              "path": ["api", "search.php"],
              "query": [
                {
                  "key": "q",
                  "value": "john"
                },
                {
                  "key": "type",
                  "value": "contacts"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/health.php",
              "host": ["{{base_url}}"],
              "path": ["api", "health.php"]
            }
          }
        }
      ]
    },
    {
      "name": "Custom Fields",
      "item": [
        {
          "name": "Get Custom Fields",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{api_key}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/custom_fields.php?module=contacts",
              "host": ["{{base_url}}"],
              "path": ["api", "custom_fields.php"],
              "query": [
                {
                  "key": "module",
                  "value": "contacts"
                }
              ]
            }
          }
        },
        {
          "name": "Create Custom Field",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{api_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrf_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"module\": \"contacts\",\n  \"field_type\": \"text\",\n  \"label\": \"Industry\",\n  \"is_required\": false\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/custom_fields.php",
              "host": ["{{base_url}}"],
              "path": ["api", "custom_fields.php"]
            }
          }
        }
      ]
    },
    {
      "name": "Calendar",
      "item": [
        {
          "name": "Export Calendar (iCal)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{api_key}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/calendar/export.php?start_date=2026-01-01&end_date=2026-12-31",
              "host": ["{{base_url}}"],
              "path": ["api", "calendar", "export.php"],
              "query": [
                {
                  "key": "start_date",
                  "value": "2026-01-01"
                },
                {
                  "key": "end_date",
                  "value": "2026-12-31"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Notifications",
      "item": [
        {
          "name": "Get Notifications",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{api_key}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/notifications.php?unread_only=1",
              "host": ["{{base_url}}"],
              "path": ["api", "notifications.php"],
              "query": [
                {
                  "key": "unread_only",
                  "value": "1"
                }
              ]
            }
          }
        },
        {
          "name": "Mark Notification as Read",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{api_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrf_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"mark_read\",\n  \"notification_id\": 1\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/notifications.php",
              "host": ["{{base_url}}"],
              "path": ["api", "notifications.php"]
            }
          }
        }
      ]
    }
  ]
}
