{
    "name": "webxpanse/platform",
    "description": "AI-powered business operating platform for founder-led teams",
    "license": "proprietary",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "tecnickcom/tcpdf": "^6.6",
        "phpoffice/phpspreadsheet": "^1.29",
        "phpmailer/phpmailer": "^6.9",
        "pragmarx/google2fa": "^9.0"
    },
    "suggest": {
        "ext-imap": "Required for incoming email fetching via IMAP/POP3. Install via: apt-get install php-imap (Linux) or enable in php.ini (Windows)"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "CRM\\": "core/",
            "CRM\\Modules\\": "modules/",
            "CRM\\Services\\": "services/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CRM\\Tests\\": "tests/"
        }
    },
    "config": {
        "process-timeout": 0
    },
    "scripts": {
        "lint:php": "php scripts/php_lint.php",
        "test": "phpunit",
        "test:ai": "phpunit --testsuite AI",
        "test:ai:report": "php cli/ai_validation_report.php",
        "test:ai:probe": "php cli/ai_live_probe.php",
        "audit:takeover": "php cli/business_takeover_audit.php",
        "test:takeover": "phpunit --filter \"BusinessTakeoverConfidenceAuditServiceTest|BusinessTakeoverConfidenceAuditIntegrationTest\"",
        "test:stabilization": [
            "phpunit tests/Unit/Modules/InvoicesTest.php tests/Unit/Services/InvoiceSendServiceTest.php tests/Integration/InvoiceWorkspaceIsolationTest.php tests/Integration/AnalyticsWorkspaceIsolationTest.php tests/Integration/SaaSBillingEndpointTest.php tests/Integration/WorkspaceGovernanceEndpointTest.php tests/Unit/Services/CommercialAutomationApprovalServiceTest.php tests/Unit/Services/AIAdviceFollowThroughServiceTest.php tests/Unit/Services/MobileTokenAuthServiceTest.php",
            "@test:stabilization:smoke"
        ],
        "test:workspace-smoke": "phpunit --testsuite WorkspaceSmoke",
        "test:stabilization:smoke": "npx playwright test tests/smoke --project=chromium --workers=1 --timeout=60000",
        "migrate": "php database/migrations/migrate.php",
        "preflight:production": "php scripts/production_preflight.php",
        "templates:validate": "php scripts/validate_templates.php",
        "security:audit": "php scripts/security_hardening_audit.php",
        "integrations:check": "php scripts/check_integration_readiness.php",
        "demo:quarantine": "php scripts/verify_demo_quarantine.php",
        "cleanup:verify": "php scripts/verify_production_cleanup.php",
        "backup:check": "php scripts/check_backup_restore_readiness.php",
        "runtime:prepare": "php scripts/prepare_runtime_paths.php",
        "automation:detectors": "php scripts/run_automation_detectors.php"
    }
}
